<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.arkgon.heartsync">
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="HeartSync" android:allowBackup="false">
        <activity android:name=".ui.HeartSyncDashboardActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
